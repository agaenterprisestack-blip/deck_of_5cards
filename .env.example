# Leave empty for explicit, non-persistent local development mode.
DATABASE_URL=
# Use your provider's TLS configuration. verify-full validates server certificates.
DATABASE_SSL=disable
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# For separate frontend hosting, set this before building the frontend:
# VITE_SERVER_URL=https://your-backend.up.railway.app
# Production requires DATABASE_URL and a matching HTTPS CLIENT_ORIGIN.
NODE_ENV=development
